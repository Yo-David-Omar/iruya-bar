---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | IRUYA BAR</title>
  
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
  
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  
  <!-- Favicon -->
  <link rel="icon" href="/imagenes/logoiruya.png" type="image/png">
</head>
<body>
  <slot />

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<style is:global>
  :root {
    --cream: #F5F0E8;
    --sand: #D4C4A8;
    --earth: #8B7355;
    --brown: #5C4A3A;
    --black: #2D2A26;
    --terracotta: #B07D62;
  }
  body { 
    font-family: 'Montserrat', sans-serif; 
    background-color: var(--cream);
    color: var(--black);
  }
  h1, h2, h3, h4, h5, .font-heading { 
    font-family: 'Cormorant Garamond', serif; 
  }
  .navbar {
    background-color: rgba(245, 240, 232, 0.95);
    border-bottom: 1px solid rgba(212, 196, 168, 0.3);
    padding: 0.5rem 0;
  }
  .navbar-brand { display: flex; align-items: center; gap: 0.75rem; }
  .navbar-brand img { width: 56px; height: 56px; object-fit: contain; }
  .navbar-brand .subtitle { font-size: 9px; text-transform: uppercase; letter-spacing: 0.4em; color: var(--earth); margin: 0; }
  .nav-link {
    color: var(--brown) !important;
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; font-weight: 500;
    position: relative; margin: 0 0.5rem;
  }
  .nav-link::after {
    content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px;
    background: var(--terracotta); transition: width 0.3s ease;
  }
  .nav-link:hover::after { width: 100%; }
  .nav-link.active { color: var(--terracotta) !important; }
  .nav-link.active::after { width: 100%; }
  .btn-iruya {
    background-color: var(--brown); color: var(--cream); font-size: 11px;
    text-transform: uppercase; letter-spacing: 0.15em; padding: 0.5rem 1.5rem;
    border: none; border-radius: 0; transition: background-color 0.3s;
  }
  .btn-iruya:hover { background-color: var(--earth); color: var(--cream); }
  footer { background-color: var(--black); color: var(--cream); padding: 3rem 0; }
  footer a { color: rgba(212, 196, 168, 0.7); text-decoration: none; transition: color 0.3s; }
  footer a:hover { color: var(--terracotta); }
  footer .social-links a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; background: var(--brown); border-radius: 50%;
    margin-right: 0.5rem; color: var(--cream); transition: background-color 0.3s;
  }
  footer .social-links a:hover { background: var(--terracotta); color: var(--cream); }
  .text-brown { color: var(--brown) !important; }
  .text-earth { color: var(--earth) !important; }
  .text-terracotta { color: var(--terracotta) !important; }
  .bg-cream { background-color: var(--cream) !important; }
  .bg-brown { background-color: var(--brown) !important; }
  .page-header {
    background: linear-gradient(180deg, rgba(92,74,58,0.9), rgba(92,74,58,0.7)), 
                url('https://image.qwenlm.ai/public_source/81ecd3e3-c8b9-4448-91eb-0ca83b18b426/14c59a576-4cfd-468d-adcc-051883279a95.png');
    background-size: cover; background-position: center; padding: 8rem 0 4rem;
    text-align: center; color: var(--cream);
  }
  .page-header h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 1rem; }
  .page-header .lead { font-size: 1.1rem; opacity: 0.9; max-width: 600px; margin: 0 auto; }
  .breadcrumb-custom a { color: var(--sand); text-decoration: none; }
  .breadcrumb-custom .active { color: var(--cream); }
</style>
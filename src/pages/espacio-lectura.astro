---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Lista de PDFs - Para agregar más, solo copiá y pegá un objeto nuevo
const pdfs = [
  {
    titulo: "Guía de Meditación Mindfulness",
    categoria: "meditacion",
    categoriaLabel: "Meditación",
    tamanio: "2.4 MB",
    lectura: "15 min",
    descripcion: "Técnicas básicas de meditación consciente para reducir el estrés y conectar con el presente.",
    link: "https://drive.google.com/file/d/TU_ID_AQUI/view",
    tipo: "external" // "external" para links, "local" para archivos subidos
  },
  {
    titulo: "Secuencias de Yoga Matutino",
    categoria: "yoga",
    categoriaLabel: "Yoga",
    tamanio: "3.1 MB",
    lectura: "20 min",
    descripcion: "Rutinas de yoga para empezar el día con energía y flexibilidad. Incluye posturas ilustradas.",
    link: "https://drive.google.com/file/d/TU_ID_AQUI/view",
    tipo: "external"
  },
  {
    titulo: "Senderos de Yerba Buena",
    categoria: "naturaleza",
    categoriaLabel: "Naturaleza",
    tamanio: "5.2 MB",
    lectura: "25 min",
    descripcion: "Guía de trekking por los cerros de Yerba Buena. Mapas, dificultades y recomendaciones.",
    link: "https://drive.google.com/file/d/TU_ID_AQUI/view",
    tipo: "external"
  },
  {
    titulo: "Recetas Saludables Light",
    categoria: "recetas",
    categoriaLabel: "Recetas",
    tamanio: "4.8 MB",
    lectura: "30 min",
    descripcion: "Recetario con opciones nutritivas y deliciosas para deportistas y amantes de la vida sana.",
    link: "https://drive.google.com/file/d/TU_ID_AQUI/view",
    tipo: "external"
  },
  {
    titulo: "Rutinas de Autocuidado",
    categoria: "bienestar",
    categoriaLabel: "Bienestar",
    tamanio: "2.9 MB",
    lectura: "18 min",
    descripcion: "Hábitos diarios para mejorar tu bienestar físico y mental. Consejos prácticos y sostenibles.",
    link: "https://drive.google.com/file/d/TU_ID_AQUI/view",
    tipo: "external"
  },
  {
    titulo: "Respiración Consciente",
    categoria: "meditacion",
    categoriaLabel: "Meditación",
    tamanio: "1.8 MB",
    lectura: "10 min",
    descripcion: "Técnicas de respiración pranayama para calmar la mente y reducir la ansiedad.",
    link: "https://drive.google.com/file/d/TU_ID_AQUI/view",
    tipo: "external"
  }
];

// Categorías disponibles
const categorias = [
  { id: "all", label: "Todos" },
  { id: "meditacion", label: "Meditación" },
  { id: "yoga", label: "Yoga" },
  { id: "naturaleza", label: "Naturaleza" },
  { id: "recetas", label: "Recetas" },
  { id: "bienestar", label: "Bienestar" }
];
---

<BaseLayout title="Espacio Lectura">
  <Navbar currentPage="lectura" />
  
  <!-- HEADER DE PÁGINA -->
  <header class="page-header">
    <div class="container">
      <h1 class="font-heading">Espacio Lectura</h1>
      <p class="lead">
        Un rincón para explorar, aprender y conectar. 
        Material seleccionado para nutrir tu mente y espíritu.
      </p>
      <nav class="breadcrumb-custom d-flex justify-content-center">
        <span><a href="/">Inicio</a> / <span class="active">Espacio Lectura</span></span>
      </nav>
    </div>
  </header>

  <!-- FILTROS DE CATEGORÍAS -->
  <div class="category-filters sticky-top">
    <div class="container">
      <div class="text-center">
        {categorias.map((cat) => (
          <button 
            class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`} 
            data-filter={cat.id}>
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- PDFs GRID -->
  <section class="py-5 bg-cream">
    <div class="container py-4">
      <div class="row g-4" id="pdfs-container">
        
        {pdfs.map((pdf) => (
          <div class="col-md-6 col-lg-4" data-category={pdf.categoria}>
            <div class="card pdf-card">
              <div class="card-img-wrapper">
                <span class="pdf-badge">PDF</span>
                <i class="bi bi-file-earmark-text"></i>
              </div>
              <div class="card-body">
                <span class="pdf-category">{pdf.categoriaLabel}</span>
                <h3 class="card-title font-heading">{pdf.titulo}</h3>
                <div class="pdf-meta">
                  <span><i class="bi bi-file-earmark-pdf"></i> {pdf.tamanio}</span>
                  <span><i class="bi bi-clock"></i> {pdf.lectura} lectura</span>
                </div>
                <p class="card-text">{pdf.descripcion}</p>
                <a 
                  href={pdf.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="btn btn-view-pdf">
                  <i class="bi bi-eye"></i> Ver PDF
                </a>
              </div>
            </div>
          </div>
        ))}

      </div>

      <!-- Mensaje si no hay resultados -->
      <div id="no-results" class="text-center py-5 d-none">
        <i class="bi bi-search fs-1 text-earth mb-3"></i>
        <p class="text-earth">No se encontraron recursos en esta categoría</p>
      </div>
    </div>
  </section>

  <!-- SECCIÓN AGREGAR PDFs - INSTRUCCIONES -->
  <section class="py-5 bg-white">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="text-center mb-4">
            <h3 class="font-heading" style="color: var(--brown)">¿Cómo agregar nuevos PDFs?</h3>
            <p class="text-earth">
              Tenés dos opciones para compartir material:
            </p>
          </div>

          <div class="row g-4">
            <!-- Opción 1: Google Drive -->
            <div class="col-md-6">
              <div class="p-4 rounded" style="background: var(--cream); border: 2px solid var(--sand)">
                <i class="bi bi-google-drive fs-1 mb-3" style="color: var(--brown)"></i>
                <h4 class="font-heading mb-3">Opción 1: Google Drive</h4>
                <ol class="text-earth mb-0">
                  <li class="mb-2">Subí tu PDF a Google Drive</li>
                  <li class="mb-2">Hacé clic derecho → "Compartir"</li>
                  <li class="mb-2">Configurá como "Cualquiera con el enlace puede ver"</li>
                  <li class="mb-2">Copiá el enlace</li>
                  <li>Abrí el archivo <code>espacio-lectura.astro</code> y agregalo en la lista <code>pdfs</code></li>
                </ol>
              </div>
            </div>

            <!-- Opción 2: Subir archivo -->
            <div class="col-md-6">
              <div class="p-4 rounded" style="background: var(--cream); border: 2px solid var(--sand)">
                <i class="bi bi-cloud-upload fs-1 mb-3" style="color: var(--brown)"></i>
                <h4 class="font-heading mb-3">Opción 2: Subir al sitio</h4>
                <ol class="text-earth mb-0">
                  <li class="mb-2">Guardá el PDF en <code>public/pdfs/</code></li>
                  <li class="mb-2">El link será: <code>/pdfs/tu-archivo.pdf</code></li>
                  <li>Abrí el archivo <code>espacio-lectura.astro</code></li>
                  <li>Agregá un nuevo objeto en <code>pdfs</code> con <code>tipo: "local"</code></li>
                </ol>
              </div>
            </div>
          </div>

          <!-- Ejemplo de código -->
          <div class="mt-4 p-4 rounded" style="background: var(--black); color: var(--cream)">
            <h5 class="font-heading mb-3">Ejemplo para agregar un PDF:</h5>
            <pre class="mb-0" style="font-size: 0.85rem; overflow-x: auto">
<code>{`{
  titulo: "Tu Nuevo PDF",
  categoria: "meditacion",
  categoriaLabel: "Meditación",
  tamanio: "3.5 MB",
  lectura: "20 min",
  descripcion: "Descripción del contenido",
  link: "https://drive.google.com/...",
  tipo: "external"
}`}</code>
            </pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN INFO -->
  <section class="info-section py-5">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6 mb-4 mb-lg-0">
          <h3 class="font-heading" style="color: var(--brown)">¿Cómo acceder al material?</h3>
          <p class="mb-4 text-earth">
            Todos nuestros PDFs están alojados en Google Drive o en nuestro servidor. 
            Solo necesitas hacer click en "Ver PDF" para acceder al contenido.
          </p>
        </div>
        <div class="col-lg-6">
          <div class="info-item d-flex align-items-start mb-3">
            <i class="bi bi-cloud-check me-3" style="color: var(--terracotta); font-size: 1.5rem"></i>
            <div>
              <p class="fw-bold mb-1" style="color: var(--brown)">Acceso gratuito</p>
              <p class="small mb-0 text-earth">Todo el material está disponible sin costo</p>
            </div>
          </div>
          <div class="info-item d-flex align-items-start mb-3">
            <i class="bi bi-download me-3" style="color: var(--terracotta); font-size: 1.5rem"></i>
            <div>
              <p class="fw-bold mb-1" style="color: var(--brown)">Descarga disponible</p>
              <p class="small mb-0 text-earth">Podés descargar los PDFs para leer offline</p>
            </div>
          </div>
          <div class="info-item d-flex align-items-start mb-3">
            <i class="bi bi-calendar-plus me-3" style="color: var(--terracotta); font-size: 1.5rem"></i>
            <div>
              <p class="fw-bold mb-1" style="color: var(--brown)">Actualización constante</p>
              <p class="small mb-0 text-earth">Agregamos nuevo material regularmente</p>
            </div>
          </div>
          <div class="info-item d-flex align-items-start mb-3">
            <i class="bi bi-share me-3" style="color: var(--terracotta); font-size: 1.5rem"></i>
            <div>
              <p class="fw-bold mb-1" style="color: var(--brown)">Compartí con amigos</p>
              <p class="small mb-0 text-earth">Invitamos a compartir este espacio de aprendizaje</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="py-5 bg-cream text-center">
    <div class="container">
      <h3 class="font-heading mb-3" style="color: var(--brown)">¿Tenés material para compartir?</h3>
      <p class="text-earth mb-4">
        Si creás contenido relacionado con bienestar, yoga o vida saludable, 
        nos encantaría incluirlo en nuestro espacio.
      </p>
      <a href="/#ubicacion" class="btn btn-iruya">Contactanos</a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .category-filters {
    background: white;
    border-bottom: 1px solid rgba(212,196,168,0.3);
    padding: 1rem 0;
    z-index: 100;
  }
  
  .filter-btn {
    background: transparent;
    border: 1px solid var(--earth);
    color: var(--earth);
    padding: 0.5rem 1.25rem;
    border-radius: 2rem;
    margin: 0.25rem;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .filter-btn:hover,
  .filter-btn.active {
    background: var(--earth);
    color: var(--cream);
    border-color: var(--earth);
  }
  
  .pdf-card {
    background: white;
    border: none;
    border-radius: 0.75rem;
    box-shadow: 0 4px 15px rgba(92,74,58,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
    overflow: hidden;
  }
  
  .pdf-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(92,74,58,0.15);
  }
  
  .card-img-wrapper {
    background: linear-gradient(135deg, var(--sand), var(--earth));
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  
  .card-img-wrapper i {
    font-size: 4rem;
    color: var(--cream);
  }
  
  .pdf-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--brown);
    color: var(--cream);
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
  
  .card-body {
    padding: 1.5rem;
  }
  
  .pdf-category {
    display: inline-block;
    background: rgba(176,125,98,0.15);
    color: var(--terracotta);
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  
  .card-title {
    color: var(--brown);
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }
  
  .pdf-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    color: var(--earth);
  }
  
  .pdf-meta i {
    margin-right: 0.25rem;
  }
  
  .card-text {
    color: var(--earth);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  
  .btn-view-pdf {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--brown);
    color: var(--cream);
    padding: 0.6rem 1.5rem;
    border: none;
    border-radius: 0.35rem;
    text-decoration: none;
    transition: background 0.3s ease;
    width: 100%;
    justify-content: center;
  }
  
  .btn-view-pdf:hover {
    background: var(--earth);
    color: var(--cream);
  }
  
  .info-section {
    background: white;
  }
  
  .info-item {
    margin-bottom: 1.5rem;
  }
</style>

<script is:inline>
  // ===== FILTRADO DE PDFs POR CATEGORÍA =====
  const filterBtns = document.querySelectorAll('.filter-btn');
  const pdfCards = document.querySelectorAll('[data-category]');
  const noResults = document.getElementById('no-results');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Remover clase active de todos los botones
      filterBtns.forEach(b => b.classList.remove('active'));
      // Agregar clase active al botón clickeado
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');
      let visibleCount = 0;

      pdfCards.forEach(card => {
        const category = card.getAttribute('data-category');
        
        if (filter === 'all' || category === filter) {
          card.style.display = 'block';
          // Animación de entrada
          card.style.animation = 'fadeIn 0.5s ease';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Mostrar/ocultar mensaje de no resultados
      if (visibleCount === 0) {
        noResults.classList.remove('d-none');
      } else {
        noResults.classList.add('d-none');
      }
    });
  });

  // ===== ANIMACIÓN FADE IN =====
  const style = document.createElement('style');
  style.textContent = `
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  `;
  document.head.appendChild(style);
</script>